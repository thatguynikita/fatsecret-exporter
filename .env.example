# FatSecret API Credentials для 3-Legged OAuth
# Получите эти значения на https://platform.fatsecret.com/api/

# Для 3-Legged OAuth (доступ к пользовательским данным)
FATSECRET_CONSUMER_KEY=your_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_consumer_secret_here

# ВНИМАНИЕ: Используйте Consumer Key/Secret, НЕ Client ID/Secret!
# 3-Legged OAuth работает только с OAuth 1.0 креденциалами
